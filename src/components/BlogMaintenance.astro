---
// What every /blog URL shows while BLOG_MAINTENANCE is on. The 503 status and Retry-After are set by
// the page itself (see blog/index.astro and blog/[slug].astro); this only renders the notice.
import Base from '../layouts/Base.astro';
import Kicker from './Kicker.astro';
import { t, localePath, type Locale } from '../i18n';

interface Props { lang: Locale; path: string }
const { lang, path } = Astro.props;
---
<Base lang={lang} path={path} title={t(lang, 'seo.blog_maint_title')} description={t(lang, 'blog.maint_body')} active={null} ctaPage="blog">
  <section class="mk-container py-16">
    <Kicker class="mb-3">{t(lang, 'blog.kicker_page')}</Kicker>
    <h1 class="text-h1 m-0 max-w-[24ch]">{t(lang, 'blog.maint_title')}</h1>
    <p class="mt-4 max-w-[56ch] text-[16px] leading-[1.5] text-txt-2">{t(lang, 'blog.maint_body')}</p>
    <a href={localePath(lang, '/services')} class="btn btn-primary mt-8">{t(lang, 'blog.maint_cta')}</a>
  </section>
</Base>
