---
import { t, type Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
if (import.meta.env.PROD && !siteKey && process.env.ALLOW_MISSING_TURNSTILE !== '1') {
  throw new Error('PUBLIC_TURNSTILE_SITE_KEY is not set — contact form would silently fail');
}
---
<form id="mk-contact" method="POST" action="/api/contact" class="grid gap-6">
  <input type="hidden" name="lang" value={lang} />
  <p class="hidden" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></p>
  <div class="grid grid-cols-2 gap-6 max-[900px]:grid-cols-1">
    <label class="mk-field-label">
      {t(lang, 'contact.lbl_name')}
      <input name="name" required class="mk-field" />
    </label>
    <label class="mk-field-label">
      {t(lang, 'contact.lbl_email2')}
      <input name="email" type="email" required class="mk-field" />
    </label>
  </div>
  <label class="mk-field-label">
    {t(lang, 'contact.lbl_company')}
    <input name="company" class="mk-field" />
  </label>
  <label class="mk-field-label">
    {t(lang, 'contact.lbl_msg')}
    <textarea name="message" required rows="6" class="mk-field"></textarea>
  </label>
  {siteKey && <div class="cf-turnstile" data-sitekey={siteKey}></div>}
  <button type="submit" class="btn btn-primary w-full">{t(lang, 'contact.form_btn')}</button>
  <p id="form-sending" hidden class="m-0 text-center text-[14px] font-semibold text-txt-3">{t(lang, 'contact.status_sending')}</p>
  <p id="form-sent" class="mk-status m-0 text-center text-[14px] font-semibold">{t(lang, 'contact.status_sent')}</p>
  <p id="form-error" class="mk-status m-0 text-center text-[14px] font-semibold text-[#c13515]">{t(lang, 'contact.status_error')}</p>
  <p class="m-0 text-center text-[13px] text-txt-3">{t(lang, 'contact.form_note')}</p>
</form>
{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<style>
  .mk-status { display: none; }
  .mk-status:target { display: block; }
  .mk-status.show { display: block; }
</style>
<script>
  const form = document.getElementById('mk-contact') as HTMLFormElement;
  const show = (id: string) => {
    for (const el of form.querySelectorAll('.mk-status, #form-sending')) el.classList.remove('show');
    document.getElementById(id)?.classList.add('show');
  };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    document.getElementById('form-sending')?.removeAttribute('hidden');
    try {
      const r = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const data = await r.json();
      document.getElementById('form-sending')?.setAttribute('hidden', '');
      show(data.ok ? 'form-sent' : 'form-error');
      if (data.ok) form.reset();
    } catch {
      document.getElementById('form-sending')?.setAttribute('hidden', '');
      show('form-error');
    } finally {
      (window as any).turnstile?.reset?.();
    }
  });
</script>
