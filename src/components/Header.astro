---
import { SHOW_BLOG_IN_MENUS } from '../lib/flags.mjs';
import { localePath, nextLocale, t, type Locale } from '../i18n';
import logoBlack from '../assets/logo-black.png';

interface Props { lang: Locale; path: string; active: string | null }
const { lang, path, active } = Astro.props;
const links = [
  ['home', '/', 'common.nav_home'],
  ['services', '/services', 'common.nav_services'],
  ['portfolio', '/portfolio', 'common.nav_portfolio'],
  ...(SHOW_BLOG_IN_MENUS ? [['blog', '/blog', 'common.nav_blog']] as const : []),
  ['about', '/a-propos', 'common.nav_about'],
  ['contact', '/contact', 'common.nav_contact'],
] as const;
---
<header class="sticky top-0 z-50 border-b border-line bg-white">
  <div class="mk-container flex h-[80px] items-center justify-between gap-6">
    <a href={localePath(lang, '/')} class="flex items-center gap-3">
      <img src={logoBlack.src} alt="MAKRAZ" class="h-[34px] w-[34px] object-contain" />
      <span class="text-[16px] font-bold tracking-[.18em]">MAKRAZ</span>
    </a>
    <nav class="mk-nav flex items-center gap-8 text-[16px] font-semibold max-[900px]:hidden">
      {links.map(([key, href, label]) => (
        <a
          href={localePath(lang, href)}
          class:list={[
            'whitespace-nowrap border-b-2 py-2',
            active === key ? 'border-ink text-ink' : 'border-transparent text-txt-3 hover:text-ink',
          ]}
        >{t(lang, label)}</a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a
        href={localePath(nextLocale(lang), path)}
        class="inline-flex h-10 min-w-10 items-center justify-center rounded-pill border border-line-mid px-3 text-[14px] font-semibold hover:bg-surface-soft"
      >{t(lang, 'common.toggle')}</a>
      <button
        id="mk-burger"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mk-mobile-menu"
        class="hidden h-10 w-10 items-center justify-center rounded-pill border border-line-mid text-[16px] leading-none hover:bg-surface-soft max-[900px]:inline-flex"
      >☰</button>
      <a
        href={localePath(lang, '/contact')}
        class="btn min-h-10 bg-ink px-4 py-[10px] text-[14px] text-white hover:bg-ink-soft max-[900px]:hidden"
      >{t(lang, 'common.nav_cta')}</a>
    </div>
  </div>
  <nav id="mk-mobile-menu" hidden class="flex flex-col border-t border-line px-6 pb-4 pt-2 text-[16px] font-semibold">
    {links.map(([, href, label]) => (
      <a href={localePath(lang, href)} class="flex min-h-12 items-center">{t(lang, label)}</a>
    ))}
  </nav>
</header>
<script>
  const burger = document.getElementById('mk-burger');
  const menu = document.getElementById('mk-mobile-menu');
  burger?.addEventListener('click', () => {
    const open = menu!.toggleAttribute('hidden');
    burger.setAttribute('aria-expanded', String(!open));
  });
</script>
