---
// The only new component the service pages introduce: used for a pillar's child grid and for the
// sibling grid on a leaf page. Same card treatment as the home pillars so nothing new is invented.
import { localePath, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  slug: string;
  title: string;
  lead: string;
  number?: string;
}
const { lang, slug, title, lead, number } = Astro.props;
---
<a
  href={localePath(lang, `/services/${slug}`)}
  class="mk-float flex flex-col gap-2 rounded-card border border-line bg-white p-6 no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
>
  {number && <div class="text-[13px] font-medium text-txt-4">{number}</div>}
  <h3 class="m-0 text-[16px] font-semibold leading-[1.25]">{title}</h3>
  <p class="m-0 text-[14px] leading-[1.43] text-txt-3">{lead}</p>
</a>
