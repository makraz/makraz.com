---
// The About page for English and Arabic, at the translated slug. The page itself lives in
// a-propos.astro, which serves French; it reads Astro.params.lang, so it renders the right language.
import AboutPage from './a-propos.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
}
---
<AboutPage />
