---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ImagePlaceholder from '../../../components/ImagePlaceholder.astro';
import BlogMaintenance from '../../../components/BlogMaintenance.astro';
import { t, localePath, type Locale, isLocale } from '../../../i18n';
import { BLOG_MAINTENANCE } from '../../../lib/flags.mjs';
import { answerBlogMaintenance } from '../../../lib/blog-maintenance';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: post.data.slug },
    props: { post },
  }));
}
const lang = Astro.params.lang as Locale;

// In maintenance this route is server-rendered (see the blog-maintenance integration in
// astro.config.mjs): getStaticPaths and its props are skipped, so the slug is checked against the
// collection here and only real articles answer 503; anything else is a plain 404.
if (BLOG_MAINTENANCE) {
  const exists = isLocale(lang)
    && (await getCollection('blog', (e) => e.data.lang === lang && e.data.slug === Astro.params.slug)).length > 0;
  if (!exists) return new Response(null, { status: 404 });
  answerBlogMaintenance(Astro.response);
}
const { post } = Astro.props;
// No props exist in maintenance, so the article is only rendered when the blog is live; a null
// Content is exactly the maintenance case.
const Content = BLOG_MAINTENANCE ? null : (await render(post)).Content;
---
{!Content ? <BlogMaintenance lang={lang} path={`/blog/${Astro.params.slug}`} /> : (
<Base lang={lang} path={`/blog/${post.data.slug}`} title={post.data.title} description={post.data.description} active="blog" ctaPage="article">
  <article class="mk-container mx-auto max-w-[760px] pb-24 pt-16">
    <a href={localePath(lang, '/blog')} class="text-[14px] font-semibold text-txt-4 hover:text-ink">{t(lang, 'article.back')}</a>
    <div class="mt-9 mb-5 text-[12px] font-semibold uppercase tracking-[.2em] text-txt-4">{t(lang, 'article.a_meta')}</div>
    <h1 class="text-h2 m-0">{post.data.title}</h1>

    <div class="my-11">
      <ImagePlaceholder ratio="16/8" label="Visuel de l'article" radius="media" />
    </div>

    <div class="prose max-w-none [&_h2]:text-[16px] [&_h2]:font-bold [&_h2]:tracking-[-0.02em] [&_h2]:m-0 [&_h2]:mt-[18px] [&_h2:first-child]:mt-0 [&_p]:m-0 [&_p]:text-[17px] [&_p]:leading-[1.75] [&_p]:text-[#3a3a3a] [&_p:first-of-type]:text-[16px] [&_p:first-of-type]:text-ink flex flex-col gap-[22px]">
      <Content />
    </div>

    <div class="mt-12 flex items-center gap-4 border-t border-line pt-7">
      <div>
        <div class="text-[15px] font-bold">{post.data.author}</div>
        <div class="text-[13px] text-txt-4">{post.data.authorRole}</div>
      </div>
    </div>
  </article>
</Base>
)}
